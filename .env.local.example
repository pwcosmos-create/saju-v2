GOOGLE_AI_API_KEY=
# TTS 모델 (기본 Flash 무료 티어). Pro 복귀: gemini-2.5-pro-preview-tts
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
ANTHROPIC_API_KEY=
KASI_SERVICE_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_FEEDBACK_URL=
GROQ_API_KEY=

# 젬마24 사주 카드 — Oracle live cards.json 만 사용 (로컬·pack 폴백 없음)
# Oracle VM: GEMMA24_SAJU_CARDS_PATH=/home/ubuntu/coupax-homepage/board/data/saju_learning/cards.json
# 로컬 개발: npm run sync:cards 후 아래처럼 sync 파일을 직접 지정
# GEMMA24_SAJU_CARDS_PATH=C:/path/to/saju-v2/core/data/cards.live.json
# SYNC_CARDS_SKIP=1
# SYNC_CARDS_QUIET=1
# GEMMA24_SAJU_KNOWLEDGE_ENABLED=0
# 인증(PASS) 카드 2장 이상 매칭 시 LLM 없이 조합 풀이 (기본 on, 0으로 끔)
# GEMMA24_COUNCIL_COMPOSE_FREE=0
# 인증 조합 후 [6]~[10] 등 빈 섹션만 Groq 보충 (기본 on, 0이면 조합만)
# GEMMA24_HYBRID_GROQ=0
# LLM 폴백 시에도 PASS(인증) 카드만 RAG 주입 (기본 on)
# GEMMA24_COUNCIL_CERTIFIED_ONLY=0

# AI 심층 상담 — 서버 인증 카드만으로 답변 (기본 on, Groq/Gemini 미사용)
# GEMMA24_COUNSEL_CARD_ONLY=0
# 카드·엔진 실패 시 AI 호출: auto=키 있으면 Groq/Gemini (기본), 1=항상, 0=끔
# GEMMA24_COUNSEL_LLM_FALLBACK=0
# GEMMA24_COUNSEL_LLM_FALLBACK=1
# 젬마24 초안 뒤 Gemini 코칭(표현·톤만): auto=짧은/초안 답 (기본), 1=항상, 0=끔
# GEMMA24_COUNSEL_GEMINI_COACH=0
# GEMMA24_COUNSEL_GEMINI_COACH=1
# 상담 코칭 전용 Gemini 키 (GOOGLE_AI_API_KEY 와 별도 — 코칭에만 사용)
# GEMINI_COUNSEL_COACH_API_KEY=

# 상담·심층 풀이 — 누락 PASS 카드 자동 제작 요청 (기본 on, 0으로 끔)
# GEMMA24_CARD_REQUEST_AUTO=0
# 접수 로그: council-card-requests.jsonl (커밋 제외). 수동 API: POST /api/council-card-request

# Groq 초안 뒤 Gemini 2차 검수 (TPM 2배). 기본 off — 한도 절약
# LLM_ENABLE_AUDIT=1

# AI 심층 상담 — 선택 후원 계좌 (웹 빌드 채팅 상단 안내에 표시)
NEXT_PUBLIC_SUPPORT_BANK_NAME=
NEXT_PUBLIC_SUPPORT_ACCOUNT_NO=
NEXT_PUBLIC_SUPPORT_ACCOUNT_HOLDER=
